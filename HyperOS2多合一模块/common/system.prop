#启用通知栏渐变模糊
persist.sys.advanced_visual_release=3
#降低闲置刷新率触发阈值（最低亮度也可触发）
persist.vendor.disable_idle_fps.threshold=10
#启用刷新率最低1hz显示
ro.vendor.display.primary_idle_refresh_rate=60,1:10
ro.vendor.mi_sf.aod_mode_ddic_refresh_rate=1
#启用音乐触感
ro.odm.mm.vibrator.audio_haptic_support=true
sys.haptic.media=true
sys.haptic.lowPowerMode=true
sys.haptic.onetrack=true
#启用核心分配
persist.sys.miui_animator_sched.bigcores=3-7
persist.sys.miui_animator_sched.sched_threads=0-2
persist.sys.miui_animator_sched.big_prime_cores=3-7
persist.vendor.display.miui.composer_boost=0-2
#开启dm设备映射器
persist.miui.extm.dm_opt.enable=true
#HDR支持
persist.sys.support_ultra_hdr=true